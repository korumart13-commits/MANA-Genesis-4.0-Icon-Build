# Copy to .env on the host. Never commit the real .env file.
# Generate a random value of at least 32 characters for device bearer auth.
MANA_DEVICE_BEARER_TOKEN=replace-with-a-long-random-secret
# OpenAI-compatible provider endpoint. HTTPS only.
MANA_MODEL_BASE_URL=https://provider.example
MANA_MODEL_NAME=your-model-name
MANA_MODEL_API_KEY=replace-with-provider-secret
